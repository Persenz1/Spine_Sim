{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spine-sim://schemas/m3-to-m4-dynamic-unit-sample-v4",
  "title": "M3 to M4 same-time dynamic unit sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seed",
    "terrain_recipe_id",
    "configuration_id",
    "time_s",
    "path_position_m",
    "external_total_preload_n",
    "backplate_position_xyz_m",
    "backplate_velocity_xyz_m_s",
    "backplate_acceleration_xyz_m_s2",
    "total_contact_reaction_z_n",
    "backplate_inertia_force_z_n",
    "backplate_damping_force_z_n",
    "wall_on_unit_wrench_about_origin",
    "pin_normal_force_n",
    "pin_tangential_force_n",
    "pin_normal_impulse_n_s",
    "pin_tangential_impulse_n_s",
    "pin_wrench_about_unit",
    "active_set",
    "contact_states",
    "event_label",
    "dynamic_residual_n",
    "energy_residual_j",
    "relative_energy_residual",
    "cumulative_energy_residual_j",
    "cumulative_energy_reference_j",
    "cumulative_relative_energy_error",
    "implicit_euler_dissipation_increment_j",
    "normal_contact_work_increment_j",
    "tangential_contact_work_increment_j",
    "contact_energy_injection_increment_j",
    "contact_work_identity_residual_j",
    "actual_time_step_s",
    "sample_class",
    "model_level"
  ],
  "properties": {
    "seed": {"type": "integer", "minimum": 0},
    "terrain_recipe_id": {"type": "string", "minLength": 1},
    "configuration_id": {"type": "string", "minLength": 1},
    "time_s": {"type": "number", "minimum": 0},
    "path_position_m": {"type": "number", "minimum": 0},
    "external_total_preload_n": {"type": "number", "minimum": 0},
    "backplate_position_xyz_m": {"$ref": "#/$defs/vector3"},
    "backplate_velocity_xyz_m_s": {"$ref": "#/$defs/vector3"},
    "backplate_acceleration_xyz_m_s2": {"$ref": "#/$defs/vector3"},
    "total_contact_reaction_z_n": {"type": "number"},
    "backplate_inertia_force_z_n": {"type": "number"},
    "backplate_damping_force_z_n": {"type": "number"},
    "wall_on_unit_wrench_about_origin": {"$ref": "#/$defs/wrench6"},
    "pin_normal_force_n": {"$ref": "#/$defs/nonnegativeArray"},
    "pin_tangential_force_n": {"$ref": "#/$defs/numberArray"},
    "pin_normal_impulse_n_s": {"$ref": "#/$defs/nonnegativeArray"},
    "pin_tangential_impulse_n_s": {"$ref": "#/$defs/numberArray"},
    "pin_wrench_about_unit": {
      "type": "array",
      "items": {"$ref": "#/$defs/wrench6"}
    },
    "active_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominal",
        "geometric",
        "positive_normal",
        "admissible",
        "target_load"
      ],
      "properties": {
        "nominal": {"$ref": "#/$defs/indexArray"},
        "geometric": {"$ref": "#/$defs/indexArray"},
        "positive_normal": {"$ref": "#/$defs/indexArray"},
        "admissible": {"$ref": "#/$defs/indexArray"},
        "target_load": {"$ref": "#/$defs/indexArray"}
      }
    },
    "contact_states": {
      "type": "array",
      "items": {
        "enum": [
          "free",
          "first_contact_event",
          "stick",
          "slide",
          "detach_event",
          "recontact_event",
          "impact_event"
        ]
      }
    },
    "event_label": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pin_index", "label"],
        "properties": {
          "pin_index": {"type": "integer", "minimum": 0},
          "label": {
            "enum": [
              "first_contact",
              "detach_to_free",
              "recontact",
              "impact",
              "slip_start",
              "stick_recovered",
              "hard_stop"
            ]
          }
        }
      }
    },
    "dynamic_residual_n": {"type": "number"},
    "energy_residual_j": {"type": "number"},
    "relative_energy_residual": {"type": "number", "minimum": 0},
    "cumulative_energy_residual_j": {"type": "number"},
    "cumulative_energy_reference_j": {"type": "number", "minimum": 0},
    "cumulative_relative_energy_error": {"type": "number", "minimum": 0},
    "implicit_euler_dissipation_increment_j": {"type": "number"},
    "normal_contact_work_increment_j": {"type": "number"},
    "tangential_contact_work_increment_j": {"type": "number"},
    "contact_energy_injection_increment_j": {
      "type": "number",
      "minimum": 0
    },
    "contact_work_identity_residual_j": {"type": "number"},
    "actual_time_step_s": {"type": "number", "exclusiveMinimum": 0},
    "sample_class": {"enum": ["steady", "impact", "other_event", "transient"]},
    "model_level": {
      "const": "project_model_P_common_rigid_backplate_z_dynamic_continuous_total_preload_v3"
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "wrench6": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 6,
      "maxItems": 6
    },
    "numberArray": {
      "type": "array",
      "items": {"type": "number"}
    },
    "nonnegativeArray": {
      "type": "array",
      "items": {"type": "number", "minimum": 0}
    },
    "indexArray": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "uniqueItems": true
    }
  }
}
